            "alertEmailAddresses": {
              "type": "array",
              "metadata": {
                "description": "Email recipients for alerts. An empty list creates the alert rules without notification routing; routing is the receiving team's decision."
              }
            }
          },
          "variables": {
            "hasRecipients": "[not(empty(parameters('alertEmailAddresses')))]",
            "actions": "[if(variables('hasRecipients'), createArray(createObject('actionGroupId', resourceId('Microsoft.Insights/actionGroups', format('{0}-alerts', parameters('stem'))))), createArray())]"
          },
          "resources": [
