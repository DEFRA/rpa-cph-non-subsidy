@model X.PagedList.IPagedList<RPA.CPH.NonSubsidy.Domain.Classes.CPH.Customer>

@{
    ViewBag.Title = "CPH Non Subsidy";
}

@using X.PagedList.Mvc.Core;
@using X.PagedList;

<h2>CPH Non Subsidy Cases</h2>

<div class="float-left clear-left">

    <form action="@Url.Page("/Index")" method="get">

        <div class="float-left">
            <input type="text" name="searchString" id="searchString" value="@ViewBag.SearchString" />
        </div>
        <div class="float-left" style="margin-left:10px">
            <button class="button" style="position:static;" id="searchButton">Search</button>
            <button style="position:static;" id="resetButton" onclick="location.href='@Url.Page("/Index", new { searchString = string.Empty })'">Reset</button>
        </div>
    </form>

</div>

<div class="float-right clear-none">
    <div class="clear-both float-right">
        <button class="button" style="position:static;" onclick="location.href='@Url.Page("/Customer")'">New Customer</button>
    </div>
    <div class="clear-both float-right">
        <a asp-page="/Extract">Download Customer Data</a>
    </div>
</div>

@if (Model.Count > 0)
{
    <div class="float-left clear-both">
    <table class="table">
        <tr>
            <th>@Html.DisplayNameFor(model => model[0].SBI)</th>
            <th>CPH</th>
            <th>Address</th>
            <th>Land Parcels</th>
            <th>@Html.DisplayNameFor(model => model[0].Case.CRMCaseReferenceNumber)</th>
            <th></th>
        </tr>

        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.SBI</td>
                <td>@customer.Land.FirstOrDefault()?.CPH</td>
                <td style="width:400px;">@customer.Addresses.FirstOrDefault()?.FullAddress</td>
                <td style="width:300px;">@customer.Land.FirstOrDefault()?.LandParcelDetails</td>
                <td>@customer.Case?.CRMCaseReferenceNumber</td>
                <td><a asp-page="/Customer" asp-route-customerId="@customer.CustomerId">Update</a></td>
            </tr>
        }

    </table>
        </div>

    <div class="float-left clear-left">
        @* "page" is a Razor Pages route key; keep the existing paging query parameter separate. *@
        @Html.PagedListPager(Model, page => Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(
            Url.Page("/Index"), new Dictionary<string, string> {
                ["SearchString"] = (string)ViewBag.SearchString,
                ["page"] = page.ToString(),
                ["pageSize"] = Model.PageSize.ToString()
            }))
        Showing @(Model.TotalItemCount < Model.FirstItemOnPage ? 0 : Model.FirstItemOnPage) to @Model.LastItemOnPage of @Model.TotalItemCount customers
    </div>
}
else
{
    <div class="info-box float-left clear-both" style="margin-left:20px; margin-bottom:10px; margin-top:10px;">
        <div class="infolabel">
            <p>No customer data has been created.</p>
        </div>
    </div>
}

<script>

    $('#resetButton').click(function (e) {
        e.preventDefault();
    });

</script>