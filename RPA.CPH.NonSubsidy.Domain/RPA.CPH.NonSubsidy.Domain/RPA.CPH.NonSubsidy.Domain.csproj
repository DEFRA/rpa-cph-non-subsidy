<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>RPA.CPH.NonSubsidy.Domain</RootNamespace>
    <AssemblyName>RPA.CPH.NonSubsidy.Domain</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Original EF6 migrations and snapshots are a non-executable historical archive. -->
    <Compile Remove="Migrations\**\*.cs" />
    <None Include="Migrations\**\*.cs" />
    <EmbeddedResource Remove="Migrations\*.resx" />
    <None Include="Migrations\*.resx" />
  </ItemGroup>

</Project>
